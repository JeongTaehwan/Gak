# =============================================================================
# 로컬 개발용 설정 템플릿.
#   1) 이 파일을 같은 폴더에 application-local.yml 로 복사한다.
#   2) 아래 빈 자리에 로컬 값을 채운다.
#   3) SPRING_PROFILES_ACTIVE=local 로 앱을 구동한다.
#        예) ./gradlew bootRun --args='--spring.profiles.active=local'
#
# application-local.yml 은 .gitignore 되어 있어 커밋되지 않는다.
# ※ 여기(.example)에도 실제 키/비밀번호를 적지 말 것 — 자리 표시만.
# =============================================================================

spring:
  datasource:
    # 로컬 PostgreSQL JDBC URL. 예: jdbc:postgresql://localhost:5432/gak
    url: jdbc:postgresql://localhost:5432/gak
    username: ""      # 로컬 DB 사용자
    password: ""      # 로컬 DB 비밀번호

gak:
  api-football:
    key: ""           # API-Football 키 (v3.football.api-sports.io)

    # 로컬은 replay 로 둔다. 실 호출은 필요할 때만 한 번씩 켠다.
    #   ./gradlew bootRun --args='--spring.profiles.active=local --gak.api-football.mode=real'
    mode: replay

    # real 로 켤 때만 의미가 있다. 받은 원본이 여기 쌓여 다음부터 replay 로 재생된다.
    # capture-dir: "src/test/resources/apifootball"

  sync:
    # 로컬에서 스케줄러가 계속 도는 게 거슬리면 false 로.
    enabled: true

    # 한 번 깨어날 때 처리할 대회 수 상한(기본 6).
    # 로컬은 replay(요청 0회)라 20개 전부 한 번에 처리해도 공짜다.
    max-competitions-per-run: 20

    # season-override — 왜 넣었나 / 언제 빼야 하나
    #  [왜]  동기화는 원래 "오늘 기준 현재 시즌"을 스스로 계산한다(유럽 리그는 7월부터 새 시즌).
    #        그런데 저장해 둔 replay 파일은 2024 시즌뿐이라, 자동 판정에 맡기면 없는 파일을
    #        찾다 전부 실패한다. 그래서 "파일이 있는 시즌"으로 못 박아 둔 것이다.
    #  [언제 빼나]  유료 플랜으로 현재 시즌을 받게 됐거나, real 모드로 현재 시즌 응답을
    #        capture 해 둔 뒤. 그때 이 줄을 지우면 자동 판정으로 돌아간다.
    #  [안 빼면]  2024 시즌만 계속 덮어쓴다. 앱은 멀쩡해 보이는데 화면엔 2년 전 일정이 나온다.
    #
    #  🚩 2026-08-21 개막에 맞춰 현재 시즌을 캡처하면 이 줄을 지운다.
    #     지우는 걸 잊으면 아무 에러 없이 계속 옛 시즌만 나온다 — 전체 체크리스트는
    #     레포 루트 CLAUDE.md 상단 "2026-08-21 (시즌 개막) 전에 반드시 할 일" 참고.
    season-override: 2024

  anthropic:
    # AI 진단용 키. **비워 두어도 앱은 정상 동작한다** — 진단 탭이 규칙 기반 문장으로
    # 돌아갈 뿐이고, 화면 배지도 "규칙 기반"으로 정직하게 표시된다.
    key: ""
    # 아래는 전부 선택. 기본값이 application.yml 에 있다.
    # model: claude-opus-5
    # effort: medium    # low 는 사고 토큰이 0 이 되어 근거 없는 결론이 나온다
    # max-tokens: 4096  # 사고 + 응답을 합친 상한
    # timeout: 60s      # medium 실측 26초. 넘기면 규칙 기반 문장을 그대로 둔다
