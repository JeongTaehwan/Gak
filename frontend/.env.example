# 프론트엔드 환경변수 템플릿.
#   이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 .gitignore 됨).
# ※ 실제 값/시크릿은 여기에 적지 말 것 — 자리 표시만.
# ※ 브라우저에 노출되는 NEXT_PUBLIC_* 에는 절대 비밀 키를 넣지 않는다.
#   API-Football/Anthropic 키 같은 시크릿은 백엔드에서만 다룬다.

# 백엔드(Spring Boot) API 베이스 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 데이터 출처 — 비워 두면 백엔드를 부른다(기본).
#   mock 으로 두면 백엔드 없이 개발용 스냅샷(맨유 2023-24, 52경기)으로 화면을 그린다.
#   백엔드가 죽었을 때 자동으로 목으로 넘어가지는 않는다 — 화면은 멀쩡한데 숫자가 가짜인
#   상태가 가장 눈치채기 어려운 실패라, 전환은 사람이 명시적으로 한다.
#   NEXT_PUBLIC_ 접두어가 없는 건 의도다(서버 컴포넌트에서만 읽으므로 브라우저 번들에
#   실릴 이유가 없다).
# GAK_DATA_SOURCE=mock

# 앞단 프록시(nginx 등)가 X-Forwarded-For 를 신뢰할 수 있게 덮어쓰는 배포에서만 true.
#   true 면 프록시 라우트가 들어온 XFF 를 백엔드로 전달해 IP 단위 한도가 동작한다.
#   기본(false/미설정)은 전달하지 않는다 — 위조 가능한 헤더를 보증 없이 넘기지 않는다.
#   (백엔드 gak.ai-limit.trusted-proxies 와 짝으로 움직인다. DG 8절 / DG-OQ-20)
# GAK_FRONT_PROXY_TRUSTED=true
